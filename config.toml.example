# SSH Honeypot Configuration Example
# Copy this file to config.toml and modify as needed

# PostgreSQL database connection URL
# Format: postgresql://username:password@hostname:port/database_name
# Default: Uses local PostgreSQL with honeypot user
database_url = "postgresql://honeypot:honeypot@localhost:5432/ssh_honeypot"

# Network interfaces to listen on (can specify multiple)
# Default: ["0.0.0.0:2222", "[::]:2222"] (IPv4 and IPv6)
interfaces = [
    "0.0.0.0:2222",        # IPv4 all interfaces
    "[::]:2222",           # IPv6 all interfaces
    "0.0.0.0:22",
    "[::]:22"
    # "192.168.1.100:22",  # Specific IPv4 interface
    # "127.0.0.1:2223",    # Local testing
]

# Disable the interactive shell simulation (only log auth attempts)
# Default: false
disable_cli_interface = false

# Disable exec request handling (ssh user@host "command")
# Commands are still logged. Does not affect the interactive shell.
# Default: false
disable_exec = false

# SSH authentication banner (makes honeypot appear more realistic)
# Default: none
authentication_banner = "Ubuntu 22.04.3 LTS"

# SSH server identification string (what clients see during connection)
# Default: "SSH-2.0-OpenSSH_8.2p1 Ubuntu-4ubuntu0.4"
server_id = "SSH-2.0-OpenSSH_8.2p1 Ubuntu-4ubuntu0.4"

# Welcome message system description (displayed in login banner)
# Default: "Ubuntu 20.04.4 LTS (GNU/Linux 5.4.0-109-generic x86_64)"
welcome_message = "Ubuntu 20.04.4 LTS (GNU/Linux 5.4.0-109-generic x86_64)"

# Hostname displayed in shell prompt and commands
# Default: "server01"
hostname = "server01"


# The following two options are easter eggs / a little bit of fun. Check if they violate existing laws in your country before activating. May increase honeypot fingerprinting
# Show a post-auth MOTD imitating a German BSI/ZITiS investigation warning.
# The EVIDENCE RECORD ID in it embeds the current year and the UUID of the
# recorded auth attempt from the database.
# Default: false
bsi_motd = false

# Show a post-auth MOTD imitating an NSA/CSS classified collection warning
# Default: false
nsa_motd = false

# Enable tarpit mode (slow responses to waste attacker time)
# Default: false
tarpit = false

# Disable loading base filesystem from base.tar.gz
# Default: false (loads debian 12 filesystem simulation)
disable_base_tar_gz_loading = false

# Path to base filesystem archive (for realistic file simulation)
# Default: uses XDG data directory or ./base.tar.gz
# base_tar_gz_path = "/path/to/custom/base.tar.gz"

# Directory containing SSH server keys
# Default: uses XDG config directory or ./keys
# key_folder = "/path/to/ssh/keys"

# Network socket options (advanced)
disable_so_reuseport = false
disable_so_reuseaddr = false

# Enable SFTP subsystem support
# When enabled, SFTP connection attempts will be handled.
enable_sftp = false

# AbuseIPDB API key for IP reputation checking
# Get your free API key at: https://www.abuseipdb.com/api
# Default: none (AbuseIPDB integration disabled)
abuse_ip_db_api_key = "your_api_key_here"

# AbuseIPDB cache cleanup interval in hours
# How often to clean up expired database cache entries (default: 24 hours)
# Note: Cache entries expire after 24 hours but cleanup only happens at this interval
abuse_ip_cache_cleanup_interval_hours = 24

# Reject all authentication attempts instead of accepting them
# Default: false (honeypot mode - accepts all auth)
# When true: operates in logging mode - rejects all auth but still logs attempts
reject_all_auth = false

# Disable IPAPI geolocation service integration
# Default: false (IPAPI enabled for geographic intelligence)
# Note: Free IPAPI tier uses HTTP (no HTTPS) - disable if this is a security concern
disable_ipapi = false

##############################################################################
# MySQL module
##############################################################################
[mysql]

# Enable the MySQL honeypot module (can also be enabled with --enable-mysql)
# Default: false
enabled = false

# Network interfaces for the MySQL module to listen on
# Default: ["0.0.0.0:3306", "[::]:3306"]
interfaces = [
    "0.0.0.0:3306",        # IPv4 all interfaces
    "[::]:3306",           # IPv6 all interfaces
]

# Reject all MySQL authentication attempts instead of accepting them
# Default: false (honeypot mode - accepts all auth but still logs)
reject_all_auth = false

# MySQL server version string reported in the handshake packet
# Default: "8.0.36-0ubuntu0.22.04.1"
server_version = "8.0.36-0ubuntu0.22.04.1"

# Support TLS connections (CLIENT_SSL is advertised so clients with
# ssl-mode PREFERRED/REQUIRED can encrypt the connection). The clear
# password auth switch is then sent over the encrypted channel.
# Default: true
enable_tls = true

# Optional PEM certificate chain + private key to serve. When unset a
# fresh self-signed certificate for "localhost" is generated at startup.
# Both options must be set together.
# tls_cert = "/etc/ssl/certs/honeypot.pem"
# tls_key = "/etc/ssl/private/honeypot.key"

##############################################################################
# MSSQL module
##############################################################################
[mssql]

# Enable the MSSQL (Microsoft SQL Server / TDS) honeypot module
# (can also be enabled with --enable-mssql)
# Default: false
enabled = false

# Network interfaces for the MSSQL module to listen on
# Default: ["0.0.0.0:1433", "[::]:1433"]
interfaces = [
    "0.0.0.0:1433",        # IPv4 all interfaces
    "[::]:1433",           # IPv6 all interfaces
]

# Reject all MSSQL authentication attempts instead of accepting them
# Default: false (honeypot mode - accepts all auth but still logs)
reject_all_auth = false

# SQL Server version string reported in the prelogin and login ack
# Default: "16.0.1000.6" (SQL Server 2022 RTM)
server_version = "16.0.1000.6"

# Support TLS connections (ENCRYPT_OFF is advertised so clients can
# encrypt the login sequence; TDS 8.0 "strict" clients are also served).
# Default: true
enable_tls = true

# Optional PEM certificate chain + private key to serve. When unset a
# fresh self-signed certificate is generated at startup.
# Both options must be set together.
# tls_cert = "/etc/ssl/certs/honeypot.pem"
# tls_key = "/etc/ssl/private/honeypot.key"

# Windows computer name presented in NTLM challenges and error messages
# Default: "WIN-SERVER01"
host_name = "WIN-SERVER01"

# NetBIOS domain name presented in NTLM challenges. For a standalone
# server this is normally identical to the computer name.
# Default: same as host_name
# domain_name = "WORKGROUP"

##############################################################################
# Environment Variable Equivalents
##############################################################################
# All config options can also be set via environment variables:
#
# DATABASE_URL=postgresql://user:pass@host:port/db
# INTERFACE=0.0.0.0:2222
# DISABLE_CLI_INTERFACE=true
# DISABLE_EXEC=true
# AUTHENTICATION_BANNER="Ubuntu 22.04.3 LTS"
# SERVER_ID="SSH-2.0-OpenSSH_8.2p1 Ubuntu-4ubuntu0.4"
# WELCOME_MESSAGE="Ubuntu 20.04.4 LTS (GNU/Linux 5.4.0-109-generic x86_64)"
# HOSTNAME="server01"
# TARPIT=true
# DISABLE_BASE_TAR_GZ_LOADING=true
# BASE_TAR_GZ_PATH=/path/to/base.tar.gz
# KEY_FOLDER=/path/to/keys
# DISABLE_SO_REUSEPORT=true
# DISABLE_SO_REUSEADDR=true
# ENABLE_SFTP=true
# ABUSE_IP_DB_API_KEY=your_api_key_here
# ABUSE_IP_CACHE_CLEANUP_HOURS=24
# REJECT_ALL_AUTH=true
# DISABLE_IPAPI=true
# ENABLE_MYSQL=true
# ENABLE_MSSQL=true
# BSI_MOTD=true
# NSA_MOTD=true
#
# CLI arguments take precedence over config file, which takes precedence over environment variables.
